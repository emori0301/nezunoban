; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="寝ずの番 | The Wake"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/low_processor_mode=false
config/icon="res://icon.svg"

[autoload]

Game="*res://src/autoload/game.gd"
Clock="*res://src/autoload/clock.gd"
Dread="*res://src/autoload/dread.gd"
Events="*res://src/autoload/events.gd"
Audio="*res://src/autoload/audio.gd"
Dialogue="*res://src/autoload/dialogue.gd"
Tasks="*res://src/autoload/tasks.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[gui]

theme/default_font_antialiasing=0
theme/default_font_hinting=0
theme/default_font_subpixel_positioning=0

